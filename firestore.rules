rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isActiveAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    match /users/{uid} {
      allow read: if isActiveAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isActiveAdmin();
      allow delete: if false;
    }

    match /settings/{documentId} {
      allow read, write: if isActiveAdmin();
    }

    match /templates/{templateId} {
      allow read, write: if isActiveAdmin();
    }

    match /candidates/{candidateId} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    match /send_queues/{queueId} {
      allow read: if isActiveAdmin();
      allow write: if false;

      match /items/{itemId} {
        allow read: if isActiveAdmin();
        allow write: if false;
      }

      match /changes/{changeId} {
        allow read: if isActiveAdmin();
        allow write: if false;
      }
    }

    match /send_histories/{historyId} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    match /excluded_accounts/{xUserId} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    match /conversions/{conversionId} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    match /function_logs/{logId} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    match /x_api_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /candidate_sync_runs/{runId} {
      allow read: if isActiveAdmin();
      allow write: if false;

      match /items/{itemId} {
        allow read: if isActiveAdmin();
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
